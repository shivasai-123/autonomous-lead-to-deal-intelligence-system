# ========================================================
# AUTONOMOUS LEAD-TO-DEAL INTELLIGENCE SYSTEM
# Root Environment Configuration Template (.env.example)
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Phase 2 connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_crm?schema=public

# Security / Authentication (Phase 3)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# OpenAI Integration (Phase 8 - AI Engine)
# Note: Not required to run Phase 1
OPENAI_API_KEY=your_openai_api_key_here

# Client Environment (Vite prefix)
VITE_API_BASE_URL=http://localhost:5000/api

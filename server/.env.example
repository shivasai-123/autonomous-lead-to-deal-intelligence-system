PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Phase 2 connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_crm?schema=public

# Security / JWT (Phase 3)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# OpenAI API Configuration (Phase 8) - Optional for core CRM
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
